{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sortmemos",
  "version": "0.1.0",
  "identifier": "com.sortmemos.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sortmemos",
        "width": 900,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon":{
      "id":"main",
      "iconPath": "icons/32x32.png",
      "title": "sortmemos",
      "tooltip": "sortmemos"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
  "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
