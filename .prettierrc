{
    "tabWidth": 4,
    "useTabs": false,
    "bracketSameLine": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "none",
    "jsxSingleQuote": false,
    "semi": true,
    "overrides": [
        {
            "files": ["*.js", "*.ts", "*.jsx", "*.tsx"],
            "options": {
                "function-paren-newline": true,
                "function-call-argument-newline": "consistent"
            }
        },
        {
            "files": ["*.json"],
            "options": {
                "singleQuote": false
            }
        }
    ]
}
